{
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" }
  ],
  "functions": {
    "api/sync.mjs": {
      "maxDuration": 30,
      "includeFiles": "node_modules/pg/**,node_modules/pg-pool/**,node_modules/pg-protocol/**,node_modules/pg-types/**,node_modules/pgpass/**,node_modules/pg-connection-string/**"
    },
    "api/access.mjs": {
      "maxDuration": 30,
      "includeFiles": "node_modules/pg/**,node_modules/pg-pool/**,node_modules/pg-protocol/**,node_modules/pg-types/**,node_modules/pgpass/**,node_modules/pg-connection-string/**"
    }
  }
}
